<Page x:Name="MainPage1"
    x:Class="App1.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
      mc:Ignorable="d" AutomationProperties.LandmarkType="Form" RenderTransformOrigin="0.5,0.5" AllowFocusOnInteraction="False" CanBeScrollAnchor="True" CanDrag="True">
    <Page.Background>
        <ImageBrush ImageSource="ms-appx:///Assets/7d20.gif" Stretch="UniformToFill"/>
    </Page.Background>
    <Page.RenderTransform>
        <CompositeTransform ScaleY="1" ScaleX="1" TranslateX="0" TranslateY="0"/>
    </Page.RenderTransform>
    <RelativePanel x:Name="RetativePanel1" Background="{ThemeResource AppBarToggleButtonCheckedDisabledBackgroundThemeBrush}" Height="990" VerticalAlignment="Top">
        <Grid x:Name="Grid1" RenderTransformOrigin="1.896,3.593" Margin="10,100,10,10" ScrollViewer.VerticalScrollBarVisibility="Disabled" RequestedTheme="Light" Height="45">
            <Grid.Background>
                <ImageBrush ImageSource="ms-appx:///Assets/music-right.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
            </Grid.Background>
        </Grid>
        <TextBox x:Name="Textbox1"  FontSize="24" IsReadOnly="True" Text="" TextAlignment="DetectFromContent" AcceptsReturn="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="188,40,0,0" RenderTransformOrigin="1.017,0.643" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Background="White" FontStretch="Normal"/>
        <TextBox  FontSize="24" IsReadOnly="True" Text="Current music: " TextAlignment="DetectFromContent" AcceptsReturn="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,40,0,0" RenderTransformOrigin="1.017,0.643" HorizontalAlignment="Left" VerticalAlignment="Top" Width="auto" Height="auto" Background="White" RequestedTheme="Light"/>
    </RelativePanel>
</Page>